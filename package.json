{
  "name": "ecofin-api",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:contracts": "npm run build -w @ecotech/contracts",
    "predev": "npm run build:contracts",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build:contracts",
    "build": "tsc --noEmit -p tsconfig.build.json && esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "pretypecheck": "npm run build:contracts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" eslint.config.js vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest:api": "npm run build:contracts",
    "test:api": "vitest run",
    "test:contracts": "npm run test -w @ecotech/contracts",
    "test": "npm run test:api && npm run test:contracts",
    "pretest:watch": "npm run build:contracts",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build:contracts",
    "test:coverage": "vitest run --coverage",
    "db:start": "npx -y supabase@2.119.0 start",
    "db:stop": "npx -y supabase@2.119.0 stop",
    "db:reset": "npx -y supabase@2.119.0 start && npx -y supabase@2.119.0 db reset",
    "db:types": "npx -y supabase@2.119.0 gen types typescript --local --schema public | node scripts/db-types.mjs",
    "db:smoke": "node scripts/db-smoke.mjs"
  },
  "dependencies": {
    "@ecotech/contracts": "0.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "8.3.0",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "rate-limit-redis": "^4.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "iconv-lite": "0.7.3"
  }
}
