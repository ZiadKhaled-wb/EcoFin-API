# /opt/ecofin/api.env — settings for the API container (chmod 600, never commit).
# setup.sh copies this file once; fill in the values on the VM with:
#   sudo -u deploy nano /opt/ecofin/api.env
# Validated at startup by src/utils/env.ts: the container exits if one is wrong.

NODE_ENV=production
PORT=3001
SERVICE_NAME=ecofin-api
LOG_LEVEL=info

# Development environment = Supabase project "EcoFin-Development".
# Never put production keys on the development VM.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The web app that calls this API (password-reset links) and the browser origins
# allowed by CORS (comma-separated; REQUIRED when NODE_ENV=production).
FRONTEND_URL=https://<your-vercel-dev-domain>
CORS_ALLOWED_ORIGINS=https://<your-vercel-dev-domain>

# Outgoing email (P01/O02 invites and password resets), REQUIRED when NODE_ENV=production.
# Development: a Mailtrap sandbox inbox, so no email ever reaches a real person.
SMTP_URL=smtp://<mailtrap-username>:<mailtrap-password>@sandbox.smtp.mailtrap.io:2525
MAIL_FROM=EcoFin Dev <no-reply@ecofin.test>

# Full export (M03, D86): direct Postgres connection (Supabase: Project settings > Database > Connection
# string, the pooler in SESSION mode or the direct host). Needed by the export worker only.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Optional
# Q02 error tracking (docs/05-operations/monitoring.md). Without a DSN nothing is sent.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# LOG_DRAIN_URL=
# RATE_LIMIT_REDIS_URL=
