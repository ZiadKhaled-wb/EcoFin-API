# Caddy gets and renews the Let's Encrypt certificate for API_DOMAIN by itself
# (ports 80 and 443 must be open in the Azure NSG).
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3001
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	log
}
