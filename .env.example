# Server
NODE_ENV=development
PORT=3001
SERVICE_NAME=ecofin-api

# Supabase — required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend — required (used for CORS and password reset links)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_DRAIN_URL=

# Rate limiting — optional
# When unset, rate limiting uses in-memory storage (per-instance).
# RATE_LIMIT_REDIS_URL=redis://default:password@host:6379
