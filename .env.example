# EcoFin API environment. Copy to `.env` and edit. Never commit `.env` or real secrets.
# Every variable below is read by src/utils/env.ts (validated on startup; a bad or missing
# variable stops the server with one message naming each of them).

# NODE_ENV: optional. development | production | test. Default: development
NODE_ENV=development

# PORT: optional. Port the Node server listens on. Default: 3001
PORT=3001

# SERVICE_NAME: optional. Name attached to log lines. Default: fintech-pro-api
SERVICE_NAME=ecofin-api

# SUPABASE_URL: required. Project URL. Local `supabase start` uses http://127.0.0.1:54321
# (a local host is rejected when NODE_ENV=production).
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: required. Public anon key, example value only.
SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY: required. Server-only secret, example value only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SUPABASE_JWT_SECRET: optional. Only needed if we switch to local JWT verification.
# SUPABASE_JWT_SECRET=your-jwt-secret

# FRONTEND_URL: required. Web app origin, used for CORS and password reset links.
FRONTEND_URL=http://localhost:3000

# INVITE_TTL_HOURS: single-use invitations expire after this many hours (1-168). Default: 72.
INVITE_TTL_HOURS=72
# SMTP_URL: required in production; local Mailpit SMTP port exposed by supabase/config.toml.
SMTP_URL=smtp://127.0.0.1:54325
# MAIL_FROM: required in production; sender identity for Arabic/English invitations.
MAIL_FROM=EcoFin <support@ecotech.test>

# CORS_ALLOWED_ORIGINS: required in production, optional elsewhere (defaults to FRONTEND_URL).
# Comma-separated http(s) origins. `*` is rejected.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# TRUST_PROXY: optional. Number of reverse-proxy hops to trust for the client IP (rate limiting),
# or `false` when the API is reached directly. Default: 1
TRUST_PROXY=1

# LOG_LEVEL: optional. fatal | error | warn | info | debug | trace. Default: info
LOG_LEVEL=info

# LOG_DRAIN_URL: optional. Full URL (https://...) that receives logs. Leave unset to disable.
# LOG_DRAIN_URL=https://logs.example.com/ingest

# RATE_LIMIT_REDIS_URL: optional. Redis URL so rate limits are shared across instances.
# When unset, limits are in-memory per instance.
# RATE_LIMIT_REDIS_URL=redis://default:password@host:6379

# LOGIN_MAX_FAILURES: optional. Failed logins for one identifier (per shop) inside the window
# before login answers 429 TOO_MANY_LOGIN_ATTEMPTS without calling Supabase Auth (D17). Default: 5
LOGIN_MAX_FAILURES=5

# LOGIN_WINDOW_MINUTES: optional. Length of that window in minutes. Default: 15
LOGIN_WINDOW_MINUTES=15

# F13 background jobs (D34). The job worker runs inside the API; several instances are safe.
# JOBS_ENABLED: optional. 'false' turns the worker off in this process. Default: true
JOBS_ENABLED=true
# JOBS_POLL_SECONDS: optional. Seconds between worker ticks (5 to 3600). Default: 30
JOBS_POLL_SECONDS=30

# F14 file storage. FILE_MAX_BYTES: optional. Largest upload in bytes (the bucket allows 10 MB). Default: 10485760
# FILE_MAX_BYTES=10485760
# FILE_URL_TTL_SECONDS: optional. Lifetime of a signed download link, in seconds (1 to 3600). Default: 60
# FILE_URL_TTL_SECONDS=60

# Q02 error tracking (D35). Without SENTRY_DSN nothing is sent.
# SENTRY_DSN: optional. The API project's DSN from Sentry (Settings -> Projects -> ecofin-api -> Client Keys).
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# SENTRY_ENVIRONMENT: optional. Shown in Sentry. Default: NODE_ENV. Set `development` on the dev VM.
# SENTRY_ENVIRONMENT=development
# APP_RELEASE: set by the Dockerfile from the image tag; leave unset locally.

# T02 ETA e-receipts (D67). The hosts of the two ETA systems, as the SDK documents them
# (docs/eta/ERECEIPT_SPEC.md, section 1; read 12 Oct 2026). A shop's ETA settings pick the set.
# Optional: these are the defaults. The server refuses to start when a PROD and a PREPROD
# variable name the same host.
# ETA_PREPROD_ID_URL=https://id.preprod.eta.gov.eg
# ETA_PREPROD_API_URL=https://api.preprod.invoicing.eta.gov.eg
# ETA_PREPROD_PORTAL_URL=https://preprod.invoicing.eta.gov.eg
# ETA_PROD_ID_URL=https://id.eta.gov.eg
# ETA_PROD_API_URL=https://api.invoicing.eta.gov.eg
# ETA_PROD_PORTAL_URL=https://invoicing.eta.gov.eg
# Pre-production uses the ETA's own root certificate: a server that talks to it is started with
# NODE_EXTRA_CA_CERTS=<path to preprod-root-ca.crt> (docs/eta/SETUP.md). Never in production.
# The ETA_TEST_* variables of `npm run eta:preprod-smoke` are credentials: set them in the shell
# only, never in a committed file (docs/eta/SETUP.md, step 5).
