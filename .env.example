# EcoFin API environment. Copy to `.env` and edit. Never commit `.env` or real secrets.
# Every variable below is read by src/utils/env.ts.

# NODE_ENV: optional. development | production | test. Default: development
NODE_ENV=development

# PORT: optional. Port the Node server listens on. Default: 3001
PORT=3001

# SERVICE_NAME: optional. Name attached to log lines. Default: fintech-pro-api
SERVICE_NAME=ecofin-api

# SUPABASE_URL: required. Project URL. Local `supabase start` uses http://127.0.0.1:54321
# (a local host is rejected when NODE_ENV=production).
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: required. Public anon key, example value only.
SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY: required. Server-only secret, example value only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SUPABASE_JWT_SECRET: optional. Only needed if we switch to local JWT verification.
# SUPABASE_JWT_SECRET=your-jwt-secret

# FRONTEND_URL: required. Web app origin, used for CORS and password reset links.
FRONTEND_URL=http://localhost:3000

# LOG_LEVEL: optional. fatal | error | warn | info | debug | trace. Default: info
LOG_LEVEL=info

# LOG_DRAIN_URL: optional. Full URL (https://...) that receives logs. Leave unset to disable.
# LOG_DRAIN_URL=https://logs.example.com/ingest

# RATE_LIMIT_REDIS_URL: optional. Redis URL so rate limits are shared across instances.
# Redis is NOT available on Cloudflare Workers. When unset, limits are in-memory per instance.
# RATE_LIMIT_REDIS_URL=redis://default:password@host:6379
